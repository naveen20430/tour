<?php
// Database reset script - USE WITH CAUTION!
$host = 'localhost';
$username = 'root';
$password = '';
$database = 'travhub_db';

if ($_POST['confirm'] ?? '' !== 'yes') {
?>
<!DOCTYPE html>
<html>
<head>
    <title>Reset Database - TravHub</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
        .warning { background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 5px; padding: 20px; margin: 20px 0; }
        .btn { padding: 10px 20px; margin: 10px; border: none; border-radius: 5px; cursor: pointer; }
        .btn-danger { background: #dc3545; color: white; }
        .btn-secondary { background: #6c757d; color: white; }
    </style>
</head>
<body>
    <h1>⚠️ Reset Database</h1>
    
    <div class="warning">
        <h3>WARNING!</h3>
        <p>This will completely delete and recreate the TravHub database.</p>
        <p><strong>All existing data will be lost permanently!</strong></p>
        <ul>
            <li>All tours will be deleted</li>
            <li>All destinations will be deleted</li>
            <li>All bookings will be deleted</li>
            <li>Admin users will be reset</li>
        </ul>
    </div>
    
    <p>Are you sure you want to proceed?</p>
    
    <form method="POST">
        <input type="hidden" name="confirm" value="yes">
        <button type="submit" class="btn btn-danger">Yes, Reset Database</button>
        <a href="index.php" class="btn btn-secondary" style="text-decoration: none; display: inline-block;">Cancel</a>
    </form>
</body>
</html>
<?php
    exit;
}

try {
    $pdo = new PDO("mysql:host=$host", $username, $password);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    
    echo "<h2>🔄 Resetting Database...</h2>";
    
    // Drop database if exists
    $pdo->exec("DROP DATABASE IF EXISTS $database");
    echo "<p>✅ Existing database dropped</p>";
    
    // Create fresh database
    $pdo->exec("CREATE DATABASE $database CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci");
    echo "<p>✅ New database created</p>";
    
    echo "<div style='background: #d4edda; border: 1px solid #c3e6cb; border-radius: 5px; padding: 20px; margin: 20px 0;'>";
    echo "<h3>🎉 Database Reset Complete!</h3>";
    echo "<p>You can now run the setup script again:</p>";
    echo "<p><a href='setup.php' style='color: #007bff;'>Run Setup Script</a></p>";
    echo "</div>";
    
} catch(PDOException $e) {
    echo "<div style='background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 5px; padding: 15px; margin: 20px 0;'>";
    echo "<h3>❌ Reset Failed</h3>";
    echo "<p>Error: " . $e->getMessage() . "</p>";
    echo "</div>";
}
?>
